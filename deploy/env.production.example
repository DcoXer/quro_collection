APP_NAME="Quro Collection"
APP_ENV=production
APP_KEY=         # php artisan key:generate
APP_DEBUG=false
APP_URL=https://qurocollection.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quro_collection
DB_USERNAME=quro_user
DB_PASSWORD=        # dari output setup-vps.sh

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=          # smtp provider (Mailgun, Resend, SES, dll)
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@qurocollection.com"
MAIL_FROM_NAME="Quro Collection"

# ─── Midtrans ─────────────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=    # production key dari dashboard Midtrans
MIDTRANS_CLIENT_KEY=    # production key dari dashboard Midtrans
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ─── Biteship (shipping & resi) ───────────────────────────────────────────────
BITESHIP_API_KEY=       # live key dari dashboard Biteship (bukan biteship_test.*)
BITESHIP_SHIPPER_NAME="Quro Collection"
BITESHIP_SHIPPER_PHONE=    # nomor WA/HP toko
BITESHIP_SHIPPER_ADDRESS=  # alamat lengkap toko
BITESHIP_SHIPPER_AREA_ID=  # area ID Biteship (cari via API atau dashboard)

# ─── Wilayah / Ongkir ─────────────────────────────────────────────────────────
APICOIID_KEY=
APICOIID_BASE_URL=https://api.apicoiid.com
APICOIID_ORIGIN_ID=       # ID kecamatan asal pengiriman

BINDERBYTE_API_KEY=
BINDERBYTE_ORIGIN_ID=     # kode kota/kecamatan asal (Binderbyte)

# ─── Fonnte (notifikasi WhatsApp admin) ───────────────────────────────────────
FONNTE_TOKEN=         # token dari dashboard Fonnte
FONNTE_ADMIN_PHONE=   # nomor WA admin (format: 628xxx)

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://qurocollection.com/auth/google/callback

# ─── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
